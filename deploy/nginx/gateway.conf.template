# Rendered by the nginx image: ${VAR} are taken from the container environment.

resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

set_real_ip_from 127.0.0.1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

proxy_http_version 1.1;
proxy_set_header Host $http_host;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $forwarded_proto;

upstream delivest_server {
    zone delivest_server 64k;
    server server:4000 resolve;
    keepalive 32;
}

upstream delivest_client {
    zone delivest_client 64k;
    server client:3000 resolve;
    keepalive 16;
}

upstream delivest_s3 {
    zone delivest_s3 64k;
    server s3:${S3_PORT} resolve;
    keepalive 16;
}

# Customer site: every host that is not the API or the file storage
server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://delivest_client;
    }
}

# API, staff admin, websockets (/live, /socket), webhooks
server {
    listen 80;
    server_name ${PHX_HOST};

    client_max_body_size 10M;

    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json text/css application/javascript image/svg+xml;

    location / {
        proxy_pass http://delivest_server;
        proxy_read_timeout 120s;
    }
}

# File storage
server {
    listen 80;
    server_name ${S3_PUBLIC_HOST};

    client_max_body_size 20M;
    proxy_request_buffering off;

    # Public bucket: file names are unique, so responses never change
    location ^~ /${S3_BUCKET}/ {
        proxy_pass http://delivest_s3;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        proxy_pass http://delivest_s3;
    }
}
