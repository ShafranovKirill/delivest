COMPOSE_PROJECT_NAME=delivest
GATEWAY_PORT=8080

PHX_HOST=delivest-server.example.com
PHX_SERVER=true
SECRET_KEY_BASE=
CLIENT_ORIGIN=https://delivest-client.example.com
LETSENCRYPT_EMAIL=
DEFAULT_LOCALE=ru

DB_USER=delivest
DB_PASSWORD=
DB_NAME=delivest
DB_HOST=postgres

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_HOST=delivest-s3.example.com
S3_PUBLIC_HOST=delivest-s3.example.com
S3_SCHEME=https://

VITE_API_BASE_URL=https://delivest-server.example.com
APP_TIMEZONE=Europe/Moscow

# Optional Yandex advertising integration. Keep the encryption key stable across
# restarts and include it in the deployment secret backup (not in source control).
# Generate a new key with: openssl rand -base64 32
YANDEX_ADS_ENCRYPTION_KEY=
YANDEX_ADS_OAUTH_CLIENT_ID=
YANDEX_ADS_OAUTH_CLIENT_SECRET=
YANDEX_ADS_OAUTH_REDIRECT_URI=

BASTION_URL=
BASTION_TOKEN=
INSTANCE_NAME=
