ARG ELIXIR_VERSION=1.17.3
ARG OTP_VERSION=27.3.4.18
ARG DEBIAN_VERSION=bookworm-20260918-slim

FROM docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION} AS builder
WORKDIR /app

ENV MIX_ENV=prod

RUN mix local.hex --force && mix local.rebar --force

COPY agent/mix.exs agent/mix.lock ./
RUN mix deps.get --only prod && mix deps.compile

COPY agent/config config
COPY agent/lib lib

RUN mix release

FROM docker.io/library/docker:27-cli AS docker-cli

FROM docker.io/debian:${DEBIAN_VERSION}
WORKDIR /app

RUN apt-get update && apt-get install -y \
    libstdc++6 openssl libncurses5 locales ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN sed -i '/en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8 LANGUAGE=en_US:C.UTF-8 LC_ALL=en_US.UTF-8

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

RUN git config --system --add safe.directory '*'

COPY --from=builder /app/_build/prod/rel/delivest_agent ./

CMD ["bin/delivest_agent", "start"]
