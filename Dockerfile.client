FROM node:20-alpine AS builder
WORKDIR /app

ARG VITE_API_BASE_URL=https://delivest-server.shafranov.tech
ARG VITE_CAFE_NAME="Sushi Like"
ARG VITE_SITE_DESCRIPTION="Заказать горячую и ароматную еду с доставкой в офис или на дом онлайн. Натуральные ингредиенты, хрустящее тесто, быстрая доставка от 30 минут."

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CAFE_NAME=$VITE_CAFE_NAME
ENV VITE_SITE_DESCRIPTION=$VITE_SITE_DESCRIPTION

COPY client/package.json client/pnpm-lock.yaml* client/package-lock.json* ./
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate
RUN pnpm install --no-frozen-lockfile

COPY client/ ./
RUN pnpm build || npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

RUN echo 'server { \
    listen 3000; \
    location / { \
        root /usr/share/nginx/html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]